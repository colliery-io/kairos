# Rust build artifacts
/target/
**/*.rs.bk
# NOTE: Cargo.lock IS committed (workspace ships binaries; reproducible builds)

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Logs
*.log
.metis/*.log

# Test databases
*.db

# Python (angreal task venv/bytecode)
__pycache__/
*.pyc

# JS (Playwright, e2e tier)
node_modules/

# Claude Code local settings
.claude/settings.local.json

# Built wasm bundle (regenerated by trunk/angreal web build)
crates/kairos-web/dist/

# Per-repo Kairos wiring written by /kairos:bootstrap (org-specific, never committed)
.claude/kairos.local.md

# mdBook render output (KAIROS-T-0167) — the site is built by CI.
docs/book/

# The MCP endpoint of the deployment this checkout is wired to (/kairos:bootstrap).
# It names a deployment, so it is per-checkout wiring like kairos.local.md above;
# plugin/.mcp.json is the deployment-agnostic template.
/.mcp.json

# Database dumps written by the compose deployment's postgres-backup service
# (COLLIERY-T-0229). They hold every tenant's data.
/deploy/backups/
