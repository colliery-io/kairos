# Kairos reference deployment configuration (deploy/docker-compose.yaml).
# Copy to deploy/.env and edit. NEVER commit real secrets.

# Published image tag to run — never `latest` (KAIROS-A-0013).
KAIROS_VERSION=0.1.0

# Public address Caddy serves. A hostname enables automatic HTTPS;
# use ":80" for a local no-TLS trial.
KAIROS_SITE_ADDRESS=kairos.example.com

# Postgres password (sole state; back up with pg_dump per KAIROS-A-0013).
POSTGRES_PASSWORD=change-me

# Identity is external (KAIROS-A-0016) — point these at YOUR OIDC issuer.
# Examples: Okta, Entra ID, Auth0, Keycloak, Dex.
OIDC_ISSUER_URL=https://idp.example.com/
# The `aud` claim tokens must carry. Accepts a comma-separated allow-list
# (KAIROS-T-0055) for IdPs that mint a distinct `aud` per OAuth client and
# have no shared-audience mechanism — notably Google / Google Workspace,
# where GUI + CLI + service accounts each have their own client id:
#   OIDC_AUDIENCE=gui-id.apps.googleusercontent.com,cli-id.apps.googleusercontent.com
OIDC_AUDIENCE=kairos
# The public OAuth client id the GUI uses for its PKCE login.
KAIROS_WEB_CLIENT_ID=kairos-web
# Which token the GUI/CLI send as the API bearer (KAIROS-T-0054):
#   access_token (default) — Dex, Keycloak, and issuers that mint JWT access tokens
#   id_token               — issuers with OPAQUE access tokens: Google / Google Workspace
# Google's access token is an opaque `ya29.…` string; its id_token is a
# validatable RS256 JWT, so Google deployments MUST set id_token.
KAIROS_API_BEARER=access_token
# OAuth client secret for a CONFIDENTIAL GUI client (KAIROS-T-0056). Leave empty
# for public clients (Dex/Keycloak). REQUIRED for Google Workspace, whose "Web
# application" OAuth clients reject the token exchange without it even under PKCE.
# The server-side token relay presents it; it never reaches the browser.
KAIROS_WEB_CLIENT_SECRET=

# Tenant addressing. Either wildcard subdomains...
KAIROS_BASE_DOMAIN=kairos.example
# ...or pin a single tenant (evaluation installs — no wildcard DNS needed);
# leave KAIROS_BASE_DOMAIN empty if you set this:
# KAIROS_SINGLE_TENANT=acme

# Comma-separated OIDC subs allowed to call the cross-tenant admin routes.
KAIROS_DEPLOYMENT_ADMINS=

KAIROS_LOG_LEVEL=info
