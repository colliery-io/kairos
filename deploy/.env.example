# Kairos reference deployment configuration (deploy/docker-compose.yaml).
# Copy to deploy/.env and edit. NEVER commit real secrets.

# Published image tag to run — never `latest` (KAIROS-A-0013).
KAIROS_VERSION=0.5.0

# --- The front door (KAIROS-T-0209) ----------------------------------------
# Which compose profile answers requests. Pick one (both at once also works):
#   caddy      public HTTPS on this host's 80/443 — a Let's Encrypt cert for
#              KAIROS_SITE_ADDRESS, wildcard subdomain tenants possible.
#   tailscale  tailnet only. https://<TAILSCALE_HOSTNAME>.<tailnet>.ts.net/
#              with NO host ports; the node needs a TAILSCALE_AUTHKEY below.
# With neither, kairos runs and nothing can reach it.
COMPOSE_PROFILES=caddy

# caddy profile: the public address Caddy serves. A hostname enables automatic
# HTTPS; use ":80" for a local no-TLS trial. Ignored by the tailscale profile.
KAIROS_SITE_ADDRESS=kairos.example.com

# tailscale profile: joins the stack to your tailnet as one node.
# 1. Tailscale admin console → Settings → Keys → Generate auth key. A one-off
#    key is fine; the node's state persists in the `tailscale_state` volume.
# 2. Enable HTTPS Certificates for the tailnet (DNS → HTTPS Certificates).
#    Without it the serve config matches nothing and the name answers nothing.
# 3. Set COMPOSE_PROFILES=tailscale and bring the stack up.
# 4. In the admin console, disable key expiry for the new node.
# TAILSCALE_AUTHKEY=tskey-auth-...
# The node's name on the tailnet, and so the hostname you will browse to.
# TAILSCALE_HOSTNAME=kairos
# Extra `tailscale up` flags, e.g. --advertise-tags=tag:kairos
# TAILSCALE_EXTRA_ARGS=

# Postgres password (sole state; back up with pg_dump per KAIROS-A-0013).
POSTGRES_PASSWORD=change-me

# --- Scheduled database backup (COLLIERY-T-0229) ----------------------------
# The `postgres-backup` service makes a dump when it starts and then on a
# timer. It verifies each dump, and it removes old dumps only after a dump that
# succeeded.
#
# The directory ON THE HOST that gets the dumps. Put it on a different disk
# from the Docker volumes if you can. Default: ./backups next to the compose
# file.
# KAIROS_BACKUP_DIR=/srv/kairos-backups
# Seconds between dumps. Default 21600 (6 hours).
# KAIROS_BACKUP_INTERVAL=21600
# How many verified dumps to keep. Default 4, which with the default interval
# is one day.
# KAIROS_BACKUP_KEEP=4

# Identity is external (KAIROS-A-0016) — point these at YOUR OIDC issuer.
# Examples: Okta, Entra ID, Auth0, Keycloak, Dex.
# Both are OPTIONAL when KAIROS_LOCAL_AUTH=true (KAIROS-T-0208): leave them
# empty to run on local accounts alone. With local auth off they are required,
# and the server refuses to start without them.
OIDC_ISSUER_URL=https://idp.example.com/
# The `aud` claim tokens must carry. Accepts a comma-separated allow-list
# (KAIROS-T-0055) for IdPs that mint a distinct `aud` per OAuth client and
# have no shared-audience mechanism — notably Google / Google Workspace,
# where GUI + CLI + service accounts each have their own client id:
#   OIDC_AUDIENCE=gui-id.apps.googleusercontent.com,cli-id.apps.googleusercontent.com
OIDC_AUDIENCE=kairos
# The public OAuth client id the GUI uses for its PKCE login.
KAIROS_WEB_CLIENT_ID=kairos-web
# Which token the GUI/CLI send as the API bearer (KAIROS-T-0054):
#   access_token (default) — Dex, Keycloak, and issuers that mint JWT access tokens
#   id_token               — issuers with OPAQUE access tokens: Google / Google Workspace
# Google's access token is an opaque `ya29.…` string; its id_token is a
# validatable RS256 JWT, so Google deployments MUST set id_token.
KAIROS_API_BEARER=access_token
# OAuth client secret for a CONFIDENTIAL GUI client (KAIROS-T-0056). Leave empty
# for public clients (Dex/Keycloak). REQUIRED for Google Workspace, whose "Web
# application" OAuth clients reject the token exchange without it even under PKCE.
# The server-side token relay presents it; it never reaches the browser.
KAIROS_WEB_CLIENT_SECRET=

# Tenant addressing. Either wildcard subdomains...
KAIROS_BASE_DOMAIN=kairos.example
# ...or pin a single tenant (evaluation installs — no wildcard DNS needed);
# leave KAIROS_BASE_DOMAIN empty if you set this:
# KAIROS_SINGLE_TENANT=acme
# The first deployment admin to log in provisions it, with this name (the slug
# when unset):
# KAIROS_SINGLE_TENANT_NAME="Acme Inc"
# Email domains whose verified users join that tenant as members on their first
# sign-in, with no admin step (comma-separated; needs KAIROS_SINGLE_TENANT):
# KAIROS_AUTO_JOIN_DOMAINS=acme.example

# Comma-separated OIDC subs allowed to call the cross-tenant admin routes.
KAIROS_DEPLOYMENT_ADMINS=

KAIROS_LOG_LEVEL=info

# Trace export (KAIROS-T-0196). Leave empty for no tracing at all: with no
# endpoint Kairos builds no exporter and no span leaves the process.
#
# OTLP over **HTTP**, so the port is 4318 and the path matters — a collector's
# gRPC port (4317) will accept the connection and then reject the payload.
# KAIROS_OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
#
# Head sampling, 0.0-1.0. Defaults to 1.0, because someone who configured a
# collector wants to see spans in it; turn it down on a busy deployment. Keeping
# only the slow and failed traces is tail sampling, which belongs in your
# collector — it can see a whole trace where this process cannot.
# KAIROS_OTEL_SAMPLE_RATIO=0.1

# --- Failed-authentication throttling (KAIROS-T-0202) ----------------------
# Repeated failed authentications are throttled per source address (and, for
# the password login, per account). The defaults are invisible to someone who
# mistypes and expensive for a script.
#
# Failures allowed inside the window before a lockout. 0 TURNS THROTTLING OFF —
# the escape hatch for a throttle that is misfiring.
# KAIROS_AUTH_MAX_FAILURES=5
# How long failures accumulate before they are forgotten.
# KAIROS_AUTH_FAILURE_WINDOW_SECS=300
# How long a lockout lasts. Short on purpose: a long lockout is a
# denial-of-service an attacker can aim at a known account.
# KAIROS_AUTH_LOCKOUT_SECS=60
#
# How long the auth cache keeps an accepted key, session, user and role, in
# seconds (KAIROS-T-0609). A revoke takes effect at once on the server that
# made it; another server keeps the entry for at most this time. 0 turns the
# cache off.
# KAIROS_AUTH_CACHE_SECS=60
#
# The most time that a request under /api or /mcp gets, in seconds
# (KAIROS-T-0613). After it the answer is 503 REQUEST_TIMEOUT. The upload and
# the download of a code index and the publish of a site are not in it. 0 turns
# the timeout off.
# KAIROS_REQUEST_TIMEOUT_SECS=30
#
# Whether X-Forwarded-For is trusted for the client address. NOT listed here as
# a setting because this compose stack sets it itself: Caddy is the only way in,
# so the header is trustworthy. Set it to false ONLY if you change this file to
# publish the kairos port directly, and then the header is caller-supplied and
# trusting it would remove the throttle rather than weaken it.

# --- Local password accounts (KAIROS-T-0203) --------------------------------
# Accept local accounts in addition to your OIDC issuer. With this off (the
# default), POST /api/login is NOT ROUTED — a deployment that authenticates
# through an issuer has no password endpoint to attack, which is a stronger
# property than one that exists and declines.
#
# Accounts are created by an org admin; there is no self-service sign-up and no
# password-reset email. The intended uses are a small team with no identity
# provider, and a break-glass admin for a deployment whose issuer is down.
# KAIROS_LOCAL_AUTH=false
#
# How long a session bearer lasts, in seconds. Default 1209600 (14 days):
# "forever" is a permanent credential handed out by a login form, and an hour
# logs people out in the middle of the work they came to do.
# KAIROS_SESSION_TTL_SECS=1209600

# --- The first-boot admin (KAIROS-T-0204) -----------------------------------
# A fresh local-auth deployment has nobody who can log in and no way to create
# anybody, so this makes the first account.
#
# It is SINGLE-USE: consumed only on a boot that finds NO users at all, and inert
# on every boot after. Both outcomes are logged. Remove these once the account
# exists — they are a credential in your .env that no longer does anything.
#
# The email also becomes a deployment admin (as `local:<email>`), because a fresh
# deployment has no organization either and creating one is a deployment-admin
# action. Without that, the bootstrap admin could log in and do nothing.
# KAIROS_BOOTSTRAP_ADMIN=you@example.com
#
# Give ONE of these. Prefer the hash: produce it with
#   docker compose run --rm kairos hash-password
# so the plaintext is never written into a file at all.
# KAIROS_BOOTSTRAP_PASSWORD=a-long-password-you-will-change
# KAIROS_BOOTSTRAP_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$...

# KAIROS-T-0394: the code index worker. To run the builds in a container of
# their own, add `worker` to COMPOSE_PROFILES (for example caddy,worker) and
# set KAIROS_ROLE=api. A build that runs out of memory then ends the worker
# only. The worker has mem_limit 8g; raise it for big repositories. The
# worker keeps its clones and tools in its own volume at
# /var/lib/kairos/code-index; KAIROS_CODE_INDEX_DIR names another folder.
# KAIROS_ROLE=api

# --- The code index (COLLIERY-T-1853) ---------------------------------------
# The folder of the clones and the tools of the builder. Empty turns the
# builder off on the kairos service. The first start downloads about 2.7 GB.
# KAIROS_CODE_INDEX_DIR=/var/lib/kairos/code-index
# Seconds between sweeps of the indexed repositories. Default 300; 0 turns the
# builder off.
# KAIROS_CODE_INDEX_POLL_SECS=300
# CPU threads of the summary model. Default 4.
# KAIROS_CODE_INDEX_THREADS=4
# Least seconds between 2 updates of one repository. Default 0 (no limit).
# KAIROS_CODE_INDEX_MIN_REBUILD_SECS=0
# The dependency caches of the Go, TypeScript and Python runners (0.14): the
# largest total size in MB, and the least free disk space in MB before an
# install. Defaults 10240 and 5120.
# KAIROS_CODE_INDEX_DEPS_CAP_MB=10240
# KAIROS_CODE_INDEX_MIN_FREE_MB=5120
# More environment variables that a dependency install gets, by name.
# KAIROS_CODE_INDEX_DEPS_ENV=GOPROXY,NPM_CONFIG_REGISTRY
# Fetch the Python and the uv that a Python project asks for (default off).
# KAIROS_CODE_INDEX_TOOL_DOWNLOADS=true

# --- Secrets (COLLIERY-T-3105) ----------------------------------------------
# Encrypts the read and write tokens of the repositories and the webhook
# secrets. `openssl rand -base64 32`. Keep it with the database password.
# KAIROS_SECRETS_KEY=
# The old keys during a rotation (`kairos-server rotate-secrets`), comma-separated.
# KAIROS_SECRETS_KEY_OLD=

# --- Published sites (KAIROS-T-0409) ----------------------------------------
# `disk` (the default) keeps the sites in the kairos_pages volume. `s3` uses a
# bucket, with the four settings below.
# KAIROS_PAGES_STORE=disk
# KAIROS_PAGES_S3_BUCKET=
# KAIROS_PAGES_S3_PREFIX=
# KAIROS_PAGES_S3_ENDPOINT=
# KAIROS_PAGES_S3_REGION=

# --- Forge webhooks ----------------------------------------------------------
# The public base URL of this deployment, for the webhook URL an operator
# pastes into a forge, and the key each webhook secret is derived from. Both
# are needed for forge connections; with neither, the feature is off.
# KAIROS_PUBLIC_URL=https://kairos.example.com
# KAIROS_WEBHOOK_SIGNING_KEY=

# --- API keys and agent keys -------------------------------------------------
# The default life of a new key in days (default 90; 0 means no expiry), and
# how long the old secret of a rotated key works (default 86400).
# KAIROS_API_KEY_TTL_DAYS=90
# KAIROS_API_KEY_ROTATION_GRACE_SECS=86400

# A claim on a task with no write for this many days is reported to the
# holder and the owner of the initiative (default 14; 0 turns it off).
# KAIROS_STALE_CLAIM_DAYS=14

# The notices that one agent key (or one person with no key) can send in one
# hour (default 20; 0 turns the limit off). A notice to a team counts as one.
# KAIROS_NOTICE_LIMIT_PER_HOUR=20

# The connections of each of the two database pools of the server (default 16),
# the idle connections the blocking pool keeps open (default 2), and the
# connections of the pool of the jobs (default 6).
# KAIROS_POOL_SIZE=16
# KAIROS_POOL_MIN_IDLE=2
# KAIROS_JOB_POOL_SIZE=6

# --- Retention (KAIROS-A-0004) ----------------------------------------------
# The Compose file passes the server defaults for these; the server reads an
# empty retention value as an error. See the book, "Retention".
# KAIROS_HISTORY_HOT_DAYS=90
# KAIROS_HISTORY_KEEP_LATEST=5
# KAIROS_ACTIVITY_RETENTION_DAYS=365
# KAIROS_NOTIFICATIONS_READ_DAYS=30
# KAIROS_NOTIFICATIONS_UNREAD_DAYS=180
# KAIROS_CODE_INDEX_POOL_DAYS=30
# KAIROS_CODE_INDEX_KEEP=5
# archive | discard | off. `archive` with no target prunes nothing.
# KAIROS_RETENTION_MODE=archive
# A directory in the container for the archived rows, or s3://bucket/prefix
# (credentials from the AWS chain). Empty: no target.
# KAIROS_ARCHIVE_TARGET=
# The endpoint and the region of an S3-compatible store, for an s3:// target.
# KAIROS_ARCHIVE_S3_ENDPOINT=
# KAIROS_ARCHIVE_S3_REGION=

# --- The job queue (KAIROS-T-0373) ------------------------------------------
# How often a job writes its progress, how long it can run with none, and how
# many tries it gets. Defaults 30, 300, 3.
# KAIROS_JOB_HEARTBEAT_SECS=30
# KAIROS_JOB_LEASE_SECS=300
# KAIROS_JOB_MAX_TRIES=3
# The jobs of each kind that ONE server runs at the same time.
# KAIROS_JOB_LIMIT_EMBEDDED_BUILD=1
# KAIROS_JOB_LIMIT_HOSTED_BUILD=4
# KAIROS_JOB_LIMIT_EMBEDDING_BATCH=2
# KAIROS_JOB_LIMIT_PERIODIC=1
# KAIROS_JOB_LIMIT_WEBHOOK_DELIVERY=4
# KAIROS_JOB_LIMIT_GITHUB_WRITEBACK=2
# KAIROS_JOB_LIMIT_ISSUE_IMPORT=2
# KAIROS_JOB_LIMIT_ISSUE_WRITEBACK=2

# --- Webhook deliveries (KAIROS-T-0384) -------------------------------------
# KAIROS_WEBHOOK_MAX_TRIES=12
# KAIROS_WEBHOOK_RETRY_BASE_SECS=30
# KAIROS_WEBHOOK_TIMEOUT_SECS=10
# Failed tries in a row that turn a target off. 0: never.
# KAIROS_WEBHOOK_DISABLE_AFTER=24
# Send to loopback, private and link-local addresses too. Only for a receiver
# on your own network.
# KAIROS_WEBHOOK_ALLOW_PRIVATE=false

# --- GitHub and the CLI downloads -------------------------------------------
# GitHub Enterprise Server: https://<host>/api/v3. Default api.github.com.
# KAIROS_GITHUB_API_URL=https://api.github.com
# A mirror of the CLI tarballs, with the layout of the GitHub releases.
# KAIROS_CLI_DOWNLOAD_URL=https://github.com/colliery-io/kairos/releases
